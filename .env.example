NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Default local Stripe sandbox/test values. Never commit real values.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_local_listener_secret
# Hosted Stripe Connect webhook endpoints have a separate secret. For the
# local Stripe CLI listener, this may equal STRIPE_WEBHOOK_SECRET.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_endpoint_secret
STRIPE_CONNECT_COUNTRY=US
STRIPE_CAMPAIGN_TAX_CODE=txcd_20030000
STRIPE_SERVICE_FEE_TAX_CODE=txcd_20030000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional hosted endpoint used by the Stripe account audit when the local
# app origin is not the endpoint configured in the Stripe sandbox.
# STRIPE_WEBHOOK_URL=https://your-deployment.example/api/stripe/webhook
CRON_SECRET=replace-with-a-long-random-server-secret
PAYMENTS_MONITORING_SECRET=replace-with-a-different-long-random-secret

# Founder-only Slack slash command at /api/slack/admin. These are server-only.
SLACK_SIGNING_SECRET=replace-with-your-slack-app-signing-secret
SLACK_TEAM_ID=T0123456789
# Exact Slack member IDs for Aiden and KV, comma-separated. Names/emails are
# intentionally not accepted because they are mutable.
SLACK_ALLOWED_USER_IDS=U0123456789,U9876543210

# Live mode stays locked unless every independent approval is explicit. Keep
# these false in local, Preview, and sandbox environments.
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_LEGAL_APPROVED=false
PAYMENTS_TAX_APPROVED=false
PAYMENTS_OPERATIONS_READY=false
# Independent commerce kill switch. Set false to stop new Checkout Sessions
# while webhooks, refunds, disputes, and payout reconciliation keep working.
PAYMENTS_CHECKOUT_ENABLED=false

# "Fill with AI" on the listing editor. Server-only. Set one of these; the
# route uses Claude when ANTHROPIC_API_KEY is present and Gemini otherwise.
# Without either, the button says the feature is not set up.
ANTHROPIC_API_KEY=sk-ant-your-key
# Required when the key is an identity-linked key (the console's newer
# default): the workspace the requests act in, wrkspc_... from
# console.anthropic.com -> Settings -> Workspaces. Workspace-scoped keys
# can leave it unset.
ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id
# Gemini: the draft provider when ANTHROPIC_API_KEY is unset, and always the
# transcriber for "Speak & fill" recordings from browsers without built-in
# speech recognition (Firefox, Brave, in-app browsers). The free tier is
# enough for that.
# GEMINI_API_KEY=your-google-ai-studio-key

# Google Street View for physical listings: the "Add a Google Street View"
# button in the listing editor and the live card on the listing page. Google
# Cloud Console -> APIs & Services -> enable "Street View Static API" ->
# Credentials -> API key. Restrict the key to that one API, and set a daily
# quota on it (Street View Static API -> Quotas), since the listing card
# fetches a frame from Google on every view: Google's terms allow no storing
# or caching of the imagery. Metadata lookups are free; frames come out of the
# free monthly allowance at SideSpace's volume.
# GOOGLE_MAPS_API_KEY=your-google-maps-platform-key
