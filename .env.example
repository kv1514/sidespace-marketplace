NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Default local Stripe sandbox/test values. Never commit real values.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_local_listener_secret
# Hosted Stripe Connect webhook endpoints have a separate secret. For the
# local Stripe CLI listener, this may equal STRIPE_WEBHOOK_SECRET.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_endpoint_secret
STRIPE_CONNECT_COUNTRY=US
STRIPE_CAMPAIGN_TAX_CODE=txcd_20030000
STRIPE_SERVICE_FEE_TAX_CODE=txcd_20030000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional hosted endpoint used by the Stripe account audit when the local
# app origin is not the endpoint configured in the Stripe sandbox.
# STRIPE_WEBHOOK_URL=https://your-deployment.example/api/stripe/webhook
CRON_SECRET=replace-with-a-long-random-server-secret
PAYMENTS_MONITORING_SECRET=replace-with-a-different-long-random-secret

# Live mode stays locked unless every independent approval is explicit. Keep
# these false in local, Preview, and sandbox environments.
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_LEGAL_APPROVED=false
PAYMENTS_TAX_APPROVED=false
PAYMENTS_OPERATIONS_READY=false
# Independent commerce kill switch. Set false to stop new Checkout Sessions
# while webhooks, refunds, disputes, and payout reconciliation keep working.
PAYMENTS_CHECKOUT_ENABLED=false

# "Fill with AI" on the listing editor. Server-only; the route refuses to run
# without it and the button reports that plainly.
ANTHROPIC_API_KEY=sk-ant-your-key
